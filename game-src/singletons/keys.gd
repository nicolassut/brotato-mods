func _init() -> void :
	for i in range(12):
		item_builder_turret_n_hash.append(generate_hash("item_builder_turret_" + String(i)))

func generate_hash( var text: String) -> int:
	assert ( not text.is_valid_integer())
	if text == "":
		return empty_hash

	var hsh = text.hash()
	if not hash_to_string.has(hsh):
		hash_to_string[hsh] = text
	return hsh
