[layer_names]

2d_physics/layer_1="neutral"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="player_projectiles"
2d_physics/layer_5="enemy_projectiles"
2d_physics/layer_6="items"
2d_physics/layer_7="gold"
2d_physics/layer_8="obstacles"
2d_physics/layer_9="bonus_gold"
2d_physics/layer_10="pets"
2d_physics/layer_11="pet_projectiles"
2d_physics/layer_12="structures"

[locale]

test="en"
translations=PoolStringArray( "res://resources/translations/translations.de.translation", "res://resources/translations/translations.en.translation", "res://resources/translations/translations.es.translation", "res://resources/translations/translations.fr.translation", "res://resources/translations/translations.ja.translation", "res://resources/translations/translations.ko.translation", "res://resources/translations/translations.pl.translation", "res://resources/translations/translations.pt.translation", "res://resources/translations/translations.ru.translation", "res://resources/translations/translations.it.translation", "res://resources/translations/translations.tr.translation", "res://resources/translations/translations.zh.translation", "res://resources/translations/translations.zh_TW.translation", "res://items/custom/custom_translations.en.translation" )
locale_filter=[ 1, [ "de", "en", "es", "fr", "it", "ja", "ko", "pl", "pt", "ru", "tr", "zh", "zh_TW" ] ]
translation_remaps={
}

[memory]

limits/message_queue/max_size_mb=64

[network]

limits/debugger_stdout/max_chars_per_second=200000

[physics]

common/enable_pause_aware_picking=true
2d/use_bvh=false
2d/default_gravity=0
2d/default_gravity_vector=Vector2( 0, 0 )
2d/default_linear_damp=0.0
2d/default_angular_damp=0.0

[rendering]

quality/driver/fallback_to_gles2=true
quality/depth_prepass/enable=false
environment/default_environment="res://default_env.tres"

[steam]

initialization/embed_callbacks=true
