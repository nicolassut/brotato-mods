[application]

config/name="Brotato"
run/main_scene="res://pause.tscn"
config/use_custom_user_dir=true
boot_splash/image="res://splash.png"
boot_splash/bg_color=Color( 0.109804, 0.109804, 0.109804, 1 )
config/icon="res://brotato_icon.png"
config/macos_native_icon="res://brotato_icon.icns"
config/windows_native_icon="res://brotato_icon.ico"

[audio]

default_bus_layout="res://resources/music/default_bus_layout.tres"

[autoload]

CrashReporter="*res://singletons/crash_reporter.gd"
BugReporter="*res://singletons/bug_reporter.tscn"
Platform="*res://singletons/platforms/platform.gd"
Keys="*res://singletons/keys.gd"
ModLoaderStore="*res://addons/mod_loader/mod_loader_store.gd"
ModLoader="*res://addons/mod_loader/mod_loader.gd"
Utils="*res://singletons/utils.gd"
MenuData="*res://singletons/menu_data.gd"
ProgressData="*res://singletons/progress_data.gd"
AnnouncementManager="*res://singletons/announcement_manager.gd"
ItemService="*res://singletons/item_service.tscn"
SkinManager="*res://singletons/skin_manager.gd"
ZoneService="*res://singletons/zone_service.tscn"
RunData="*res://singletons/run_data.tscn"
SoundManager="*res://singletons/sound_manager.gd"
SoundManager2D="*res://singletons/sound_manager_2d.gd"
MusicManager="*res://singletons/music_manager.tscn"
Text="*res://singletons/text.gd"
ChallengeService="*res://singletons/challenge_service.tscn"
InputService="*res://singletons/input_service.gd"
WeaponService="*res://singletons/weapon_service.gd"
TempStats="*res://singletons/temp_stats.gd"
LinkedStats="*res://singletons/linked_stats.gd"
DebugService="*res://singletons/debug_service.tscn"
CursorManager="*res://singletons/cursor_manager.gd"
CoopService="*res://singletons/coop_service.tscn"
FocusEmulatorSignal="*res://singletons/focus_emulator_signal.gd"
EffectBehaviorService="*res://singletons/effect_behavior_service.tscn"
EntityService="*res://singletons/entity_service.gd"
PetService="*res://singletons/pet_service.gd"
PopinManager="*res://singletons/popin_manager.tscn"
Streamplay="*res://singletons/streamplay.tscn"
UIService="*res://singletons/ui_service.gd"
SoundService="*res://singletons/sound_service.tscn"
OS_Seaven="*res://singletons/os_seaven.gd"
GourmetTracker="*res://singletons/gourmet_tracker.gd"
ButcherSkin="*res://singletons/butcher_skin.gd"
SpecialModifiers="*res://singletons/special_modifiers.gd"

[debug]

gdscript/warnings/unused_signal=false
gdscript/warnings/integer_division=false
shapes/collision/shape_color=Color( 1, 1, 1, 0.419608 )

[display]

window/size/width=1920
window/size/height=1080
window/size/test_width=1280
window/size/test_height=720
window/dpi/allow_hidpi=true
mouse_cursor/custom_image="res://ui/custom_cursor.png"
mouse_cursor/custom_image_hotspot=Vector2( 3, 3 )
window/stretch/mode="2d"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PoolStringArray( "res://addons/brotatools/plugin.cfg" )

[global]

"allow external"=false
lang=false

[importer_defaults]

mp3={
"loop": false,
"loop_offset": 0
}

